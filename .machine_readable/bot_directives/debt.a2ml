#
# debt.a2ml — Meander debt list
# Things found but not fixed. Carried between sessions.
# Becomes the next session's Phase 0 input.
#
# Reference: ADR-002 in standards/agentic-a2ml/docs/
#
# This is the MACHINE-READABLE mirror of DEBT.md at the repository root.
# DEBT.md is authoritative for prose, evidence commands and severity rationale;
# every entry here carries the same ID so the two can be reconciled mechanically.
# When you fix an item, remove it HERE and mark it in DEBT.md — do not let the
# two drift.
#
# Populated 2026-08-07 from a full audit. It was previously empty except for
# commented examples, which meant "no known debt" — a claim nobody had checked.

[metadata]
version = "1.1.0"
last-updated = "2026-08-07"
source-of-truth = "DEBT.md"
audit-method = "every item reproduced by a command; see DEBT.md for the command"
total-items = 28

# ============================================================================
# SHOULD — would fix next wave
# ============================================================================

[[debt.should]]
id = "L-1"
component = "LICENSES/AGPL-3.0-or-later.txt"
issue = "An AGPL licence text ships in a repo that bans AGPL in four places (deny.toml, AGENTIC.a2ml, copilot-instructions, rhodibot). `reuse lint` reports it as an unused licence."
effort = "easy"
impact = "high"
priority = "should"
owner-only = true   # doctrine 6: no automated licence edits, ever
discovered = "2026-08-07"

[[debt.should]]
id = "C-1"
component = "scripts/validate-template.sh"
issue = "410-line validator is ungated AND currently red: it requires codeql.yml, deliberately deleted in ce52d18 when GitHub default CodeQL setup took over. Only caller is a benchmark that discards the exit code."
effort = "easy"
impact = "high"
priority = "should"
discovered = "2026-08-07"

[[debt.should]]
id = "P-1"
component = "verification/proofs/{coq,agda,lean4}"
issue = "Three of the four prover suites are verbatim RSR template exemplars (toy type system, list-append length, Result functor). They compile and are gated, but prove nothing about Conway physics. Highest over-reading risk in the repo."
effort = "hard"
impact = "high"
priority = "should"
discovered = "2026-08-07"

[[debt.should]]
id = "P-2"
component = "verification/proofs/idris2 <-> src"
