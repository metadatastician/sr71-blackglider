# ============================================================================
# UPSTREAM — inherited defects, fix belongs in rsr-template-repo
# ============================================================================
# Confirmed present at hyperpolymath/rsr-template-repo live main (c250e66) on
# 2026-08-07 against a fresh clone. No open issue or PR covers any of them (all
# 23 issues/PRs ever filed were enumerated). Every repo minted from that
# template inherits all seven. Filing them is an outward-facing action on
# another repository and is the owner's call — deliberately not done here.

[[debt.upstream]]
id = "U-1"
component = "rsr-template-repo:src/interface/ffi/build.zig"
issue = "Declares no build steps: `zig build` exits 0 having compiled nothing; `zig build test` errors 'no step named test'. This is what hid U-2 for the life of the template."
discovered = "2026-08-07"

[[debt.upstream]]
id = "U-2"
component = "rsr-template-repo:src/interface/ffi/src/main.zig"
issue = "Does not compile — three defects: opaque type declared with fields; std.heap.c_allocator without link_libc; callconv(.C) renamed to .c in Zig 0.16."
discovered = "2026-08-07"

[[debt.upstream]]
id = "U-3"
component = "rsr-template-repo:scripts/check-no-placeholders.sh"
issue = "Dies at exit 1 with ZERO output in any remoteless checkout (git worktree, fresh clone before remote add): `git config --get` exits 1 under `set -euo pipefail`, killing the script before it scans a single file. Piped to `tail`, it reads as a pass."
discovered = "2026-08-07"

[[debt.upstream]]
id = "U-4"
component = "rsr-template-repo:verification/proofs/lean4/ApiTypes.lean"
issue = "Binder named `max` never auto-binds because max is a global function in Lean 4; the module has never compiled."
discovered = "2026-08-07"

[[debt.upstream]]
id = "U-5"
component = "rsr-template-repo:verification/proofs/idris2/ABI"
issue = "All five Idris2 ABI modules still quarantined upstream; repaired only in this minted repo."
discovered = "2026-08-07"

[[debt.upstream]]
id = "U-6"
component = "rsr-template-repo:tests/e2e.sh"
issue = "Runs the template's own instantiation smoke test, which requires `just` on the runner and tests the wrong subject in every minted repo."
discovered = "2026-08-07"

[[debt.upstream]]
id = "U-7"
component = "rsr-template-repo:.github/workflows"
issue = "Upstream CI runs neither `zig build test` nor any proof gate — green but blind to U-1 through U-6."
discovered = "2026-08-07"
