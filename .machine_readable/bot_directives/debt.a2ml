priority = "should"
discovered = "2026-08-07"

[[debt.should]]
id = "SC-1"
component = ".github/workflows/proof-gate.yml"
issue = "Lean is installed via an unpinned `curl | sh` from elan master — a deliberate exception to the Actions SHA-pinning rule. The toolchain is pinned by lean-toolchain; the INSTALLER is not."
effort = "medium"
impact = "medium"
priority = "should"
discovered = "2026-08-07"

[[debt.should]]
id = "T-3"
component = "Justfile"
issue = "No benchmark suite and no readiness suite exist. `just bench` and `just readiness` were echo-only stubs printing success while `just test-all` depended on both; they now exit 1 as unimplemented and were removed from test-all."
effort = "medium"
impact = "medium"
priority = "should"
discovered = "2026-08-07"

